# Host and port of the FastAPI answer verifier.
HOST=0.0.0.0
PORT=8888

# Hugging Face model used for answer equivalence.
MODEL_NAME=MoritzLaurer/mDeBERTa-v3-base-mnli-xnli
MAX_LENGTH=512
THRESHOLD=0.50
ENTAILMENT_LABEL=entailment
EXACT_MATCH_ENABLED=true

# "cuda" | "cpu". Defaults to cuda when available.
DEVICE=cpu
