# --- Server -----------------------------------------------------------------
# Port the API listens on.
PORT=4000

# "development" | "production" | "test"
# In production the API also serves the built frontend (frontend/dist).
NODE_ENV=production

# Comma separated list of URLs allowed to call this API (CORS), without a
# trailing slash. Include the origin of the teacher portal and the quiz app.
# Example: https://portal.example.com,https://quiz.example.com
CLIENT_URL=

# --- Database ---------------------------------------------------------------
# Paste the connection string from MongoDB Atlas -> Database Access -> Drivers.
# Local Mongo instead? Use: mongodb://127.0.0.1:27017/teacher_portal
MONGODB_URI=

# Name of the database used in the connection string above (for logging only).
MONGODB_DB=teacher_portal

# --- API key ----------------------------------------------------------------
# Sent by the frontend in the `x-api-key` header.
# Leave it EMPTY to disable the API key check (handy while you build locally).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=

# --- Auth / JWT -------------------------------------------------------------
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
COOKIE_NAME=token

# Use secure cookies. The default is true when NODE_ENV=production.
COOKIE_SECURE=true

# Secret used to hash the stable activity/question ids. Never expose it.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ACTIVITY_LINK_SECRET=

# Public URL of the quiz app. Share links and QR codes point here.
# Example: https://quiz.example.com
QUIZ_APP_URL=

# --- Answer verification service (backend_model) ----------------------------
VERIFIER_SERVICE_HOST=127.0.0.1
VERIFIER_SERVICE_PORT=8888
VERIFIER_SERVICE_TIMEOUT_MS=15000

# --- Passwords --------------------------------------------------------------
# bcrypt cost factor. Higher is slower and safer.
BCRYPT_SALT_ROUNDS=10
